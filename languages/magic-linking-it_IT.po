#. Plugin Name of the plugin
#: magic-linking.php
msgid "Magic Linking – Internal Links"
msgstr "Magic Linking – Internal Links"

#. Plugin URI of the plugin
#: magic-linking.php
msgid "https://magiclinking.com"
msgstr "https://magiclinking.com"

#. Description of the plugin
#: magic-linking.php
msgid "Internal link suggestions in the editor. Link in one click, check that nothing else changes, undo from History. Plus orphan and broken link reports."
msgstr "Suggerimenti di link interni nell'editor. Collega con un clic, verifica che non cambi nient'altro, annulla dalla Cronologia. In più, report dei contenuti orfani e dei link non funzionanti."

