#: assets/build/index.js:113
msgid "Open the setup assistant"
msgstr "Abrir o assistente de configuração"

#: assets/build/index.js:113
msgid "Analyze everything again from scratch?"
msgstr "Analisar tudo novamente do zero?"

#: assets/build/index.js:113
msgid "Magic Linking will read every entry again. It runs in the background, so you can keep working. Analyzing only reads your content; it never changes it."
msgstr "O Magic Linking vai ler todos os conteúdos novamente. Isso é feito em segundo plano, então você pode continuar trabalhando. A análise apenas lê seu conteúdo; nunca o altera."

#: assets/build/index.js:113
msgid "Start analysis"
msgstr "Iniciar análise"

#: assets/build/index.js:113 assets/build/index.js:114
msgid "Could not load the settings."
msgstr "Não foi possível carregar as configurações."

#: assets/build/index.js:113
msgid "Settings saved. What Magic Linking reads has changed, so your site is being analyzed again."
msgstr "Configurações salvas. O que o Magic Linking lê mudou, por isso o seu site está sendo analisado novamente."

#: assets/build/index.js:113
msgid "Settings saved."
msgstr "Configurações salvas."

#: assets/build/index.js:113 assets/build/index.js:117
msgid "The settings could not be saved."
msgstr "Não foi possível salvar as configurações."

#: assets/build/index.js:113
msgid "Ignore"
msgstr "Ignorar"

#: assets/build/index.js:113
msgid "Take into account (a small boost if they share it)"
msgstr "Levar em conta (um pequeno impulso se compartilharem)"

#: assets/build/index.js:113
msgid "Require (only entries that share it)"
msgstr "Exigir (apenas conteúdos que compartilham)"

#. translators: 1: minimum, 2: maximum.
#: assets/build/index.js:114
msgid "Enter a whole number from %1$s to %2$s; otherwise it is adjusted when you leave the field."
msgstr "Digite um número inteiro de %1$s a %2$s; caso contrário, ele é ajustado quando você sair do campo."

#: assets/build/index.js:114 assets/build/index.js:117
msgid "Choose at least one content type."
msgstr "Escolha pelo menos um tipo de conteúdo."

#: assets/build/index.js:114
msgid "Unsaved changes"
msgstr "Alterações não salvas"

#: assets/build/index.js:114
msgid "(needs attention)"
msgstr "(requer atenção)"

#: assets/build/index.js:114
msgid "(unsaved changes)"
msgstr "(alterações não salvas)"

#: assets/build/index.js:114
msgid "General"
msgstr "Geral"

#: assets/build/index.js:114
msgid "Suggestions"
msgstr "Sugestões"

#: assets/build/index.js:114
msgid "Links"
msgstr "Links"

#: assets/build/index.js:114
msgid "AI"
msgstr "IA"

#: assets/build/index.js:114
msgid "History and data"
msgstr "Histórico e dados"

#: assets/build/index.js:114
msgid "Outbound suggestions in the editor"
msgstr "Sugestões de saída no editor"

#: assets/build/index.js:114
msgid "The most useful links to add from the entry you are editing."
msgstr "Os links mais úteis para adicionar a partir do conteúdo que você está editando."

#: assets/build/index.js:114
msgid "Alternative sentences per suggestion"
msgstr ""

#: assets/build/index.js:114
msgid "0 shows one sentence per suggestion. With 1 or 2, each card offers “More sentences” to link from another sentence of the same entry."
msgstr ""

#: assets/build/index.js:114
msgid "Inbound suggestions per page in the editor"
msgstr "Sugestões de entrada por página no editor"

#: assets/build/index.js:114
msgid "Entries that could link to the one you are editing, shown this many at a time."
msgstr "Conteúdos que poderiam ter link para o que você está editando, exibidos nesta quantidade por vez."

#: assets/build/index.js:114
msgid "Words per internal link"
msgstr "Palavras por link interno"

#: assets/build/index.js:114
msgid "An entry with more internal links than one for every this many words is shown as over-linked (always at least one link is allowed). Automatic rules never add a link to an entry that already has that many."
msgstr "Um conteúdo com mais links internos do que um a cada tantas palavras é exibido como excesso de links (pelo menos um link é sempre permitido). As regras automáticas nunca adicionam um link a um conteúdo que já tem essa quantidade."

#: assets/build/index.js:114
msgid "Links to the same target from one entry"
msgstr "Links para o mesmo destino a partir de um conteúdo"

#: assets/build/index.js:114
msgid "Automatic rules add at most this many links from an entry to the same target. Existing links are never removed."
msgstr "As regras automáticas adicionam no máximo essa quantidade de links de um conteúdo para o mesmo destino. Os links existentes nunca são removidos."

#: assets/build/index.js:114
msgid "Entries that can use the same anchor text for the same target"
msgstr "Conteúdos que podem usar a mesma âncora para o mesmo destino"

#: assets/build/index.js:114
msgid "Beyond this many entries, the same anchor text towards the same target is suggested less, and automatic rules stop using it in new entries."
msgstr "A partir dessa quantidade de conteúdos, o mesmo texto de âncora para o mesmo destino é menos sugerido, e as regras automáticas deixam de usá-lo em conteúdos novos."

#: assets/build/index.js:114
msgid "For example, suggest links from posts only to posts."
msgstr "Por exemplo, sugerir links de posts apenas para posts."

#: assets/build/index.js:114
msgid "Category"
msgstr "Categoria"

#: assets/build/index.js:114
msgid "In a custom content type, its main hierarchical taxonomy is used instead."
msgstr "Em um tipo de conteúdo personalizado, usa-se no lugar dela a sua principal taxonomia hierárquica."

#: assets/build/index.js:114
msgid "Tag"
msgstr "Tag"

#: assets/build/index.js:114
msgid "In a custom content type, its main non-hierarchical taxonomy is used instead."
msgstr "Em um tipo de conteúdo personalizado, usa-se no lugar dela a sua principal taxonomia não hierárquica."

#: assets/build/index.js:114
msgid "Under-linked below this many inbound links"
msgstr "Pouco vinculado abaixo deste número de links de entrada"

#: assets/build/index.js:114
msgid "An entry with at least one inbound link but fewer than this number is shown as under-linked."
msgstr "Um conteúdo com pelo menos um link de entrada, mas menos do que este número, é mostrado como pouco vinculado."

#: assets/build/index.js:114
msgid "Headings"
msgstr "Títulos"

#: assets/build/index.js:114
msgid "Quotes"
msgstr "Citações"

#: assets/build/index.js:114
msgid "Tables"
msgstr "Tabelas"

#: assets/build/index.js:114
msgid "Changing these makes Magic Linking read your entries again."
msgstr "Alterar estas opções faz o Magic Linking ler seus conteúdos novamente."

#: assets/build/index.js:114
msgid "Open links in a new tab"
msgstr "Abrir links em uma nova aba"

#: assets/build/index.js:114
msgid "Off by default. Adds target=\"_blank\" and rel=\"noopener\" to the links Magic Linking inserts; links already in your content are not changed."
msgstr "Desativado por padrão. Adiciona target=\"_blank\" e rel=\"noopener\" aos links que o Magic Linking insere; os links que já estão no seu conteúdo não são alterados."

#: assets/build/index.js:114
msgid "Additional rel values"
msgstr "Valores rel adicionais"

#: assets/build/index.js:114
msgid "Optional, separated by spaces (for example: nofollow). Added to the links Magic Linking inserts."
msgstr "Opcional, separados por espaços (por exemplo: nofollow). Adicionados aos links que o Magic Linking insere."

#: assets/build/index.js:114
msgid "Ignored addresses"
msgstr "Endereços ignorados"

#: assets/build/index.js:114
msgid "One address per line. These entries are never suggested as a target, and never suggested to link to others."
msgstr "Um endereço por linha. Esses conteúdos nunca são sugeridos como destino, nem sugeridos para ter link para outros."

#: assets/build/index.js:114
msgid "Ignored words"
msgstr "Palavras ignoradas"

#: assets/build/index.js:114
msgid "One word or phrase per line. Suggestions whose anchor text contains one of them are not shown."
msgstr "Uma palavra ou expressão por linha. Sugestões cuja âncora contenha uma delas não são exibidas."

#: assets/build/index.js:114
msgid "Daily AI limit (tokens)"
msgstr "Limite diário de IA (tokens)"

#: assets/build/index.js:114
msgid "The most tokens Magic Linking may use through your connector in a day. 0 turns AI off. When the limit is reached, AI pauses until tomorrow and the suggestions use the lexical engine."
msgstr "O máximo de tokens que o Magic Linking pode usar por dia por meio do seu conector. Com 0, a IA é desligada. Ao atingir o limite, a IA fica em pausa até amanhã e as sugestões usam o motor lexical."

#: assets/build/index.js:114
msgid "Keep the history of changes for"
msgstr "Manter o histórico de alterações por"

#: assets/build/index.js:114
msgid "Older batches are deleted by the nightly task, so you can no longer undo them. The links stay in your content. There is no limit on the number of changes kept."
msgstr "Os lotes mais antigos são excluídos pela tarefa noturna e, a partir daí, não podem mais ser desfeitos. Os links permanecem no seu conteúdo. Não há limite para o número de alterações guardadas."

#: assets/build/index.js:114
msgid "30 days"
msgstr "30 dias"

#: assets/build/index.js:114
msgid "90 days"
msgstr "90 dias"

#: assets/build/index.js:114
msgid "365 days"
msgstr "365 dias"

#: assets/build/index.js:114
msgid "No expiry date"
msgstr "Sem data de expiração"

#: assets/build/index.js:114
msgid "Delete all Magic Linking data when the plugin is deleted"
msgstr "Excluir todos os dados do Magic Linking quando o plugin for excluído"

#: assets/build/index.js:114
msgid "Removes its tables, history and settings. The links already in your entries stay as they are; your content is not touched."
msgstr "Remove as tabelas, o histórico e as configurações do plugin. Os links que já estão nos seus conteúdos ficam como estão; seu conteúdo não é alterado."

#: assets/build/index.js:114 assets/build/index.js:116
msgid "Content types to analyze"
msgstr "Tipos de conteúdo a analisar"

#: assets/build/index.js:114
msgid "Save settings"
msgstr "Salvar configurações"

#: assets/build/index.js:114
msgid "Could not load the setup information."
msgstr "Não foi possível carregar as informações de configuração."

#. translators: 1: current step, 2: number of steps.
#: assets/build/index.js:115
msgid "Step %1$s of %2$s"
msgstr "Etapa %1$s de %2$s"

#: assets/build/index.js:115
msgid "What do we link?"
msgstr "O que vamos linkar?"

#: assets/build/index.js:115
msgid "Artificial intelligence"
msgstr "Inteligência artificial"

#: assets/build/index.js:115
msgid "All set"
msgstr "Tudo pronto"

#. translators: 1: current step, 2: number of steps.
#: assets/build/index.js:116
msgid "Setup · step %1$s of %2$s"
msgstr "Configuração · etapa %1$s de %2$s"

#. translators: %s: language name.
#: assets/build/index.js:117
msgid "Language detected: %s."
msgstr "Idioma detectado: %s."

#: assets/build/index.js:117
msgid "Your site is multilingual: we will link each language separately."
msgstr "Seu site é multilíngue: vamos linkar cada idioma separadamente."

#: assets/build/index.js:117
msgid "Entries are only linked to others in the same language."
msgstr "Os conteúdos só recebem links para outros no mesmo idioma."

#: assets/build/index.js:117
msgid "Your WordPress has an AI connector. This version of Magic Linking does not use it yet: suggestions come from its own engine, which needs no AI. When AI features arrive they will use that connector, and nothing will be spent without showing you an estimate first."
msgstr "Seu WordPress tem um conector de IA. Esta versão do Magic Linking ainda não o usa: as sugestões vêm do motor próprio, que não precisa de IA. Quando os recursos de IA chegarem, eles usarão esse conector, e nada será gasto sem antes mostrar uma estimativa."

#: assets/build/index.js:117
msgid "No AI connected: Magic Linking works with its own engine, which needs no AI. You can connect one whenever you like in Settings → Connectors."
msgstr "Nenhuma IA conectada: o Magic Linking funciona com o motor próprio, que não precisa de IA. Você pode conectar uma quando quiser em Configurações → Conectores."

#: assets/build/index.js:117
msgid "Analyzing only reads your content; it never changes it. Links are only added when you press Link."
msgstr "A análise apenas lê o seu conteúdo; nunca o altera. Os links só são adicionados quando você clica em Vincular."

#: assets/build/index.js:117
msgid "The analysis is running. You can close this screen: it continues in the background."
msgstr "A análise está em andamento. Você pode fechar esta tela: ela continua em segundo plano."

#: assets/build/index.js:117
msgid "Start"
msgstr "Iniciar"

#: assets/build/index.js:117
msgid "Back"
msgstr "Voltar"

#: assets/build/index.js:117
msgid "Skip setup"
msgstr "Pular a configuração"

#: assets/build/index.js:117
msgid "You can open this assistant again from Settings."
msgstr "Você pode abrir este assistente novamente em Configurações."

#. translators: 1: entries analyzed, 2: orphan entries, 3: internal links.
#: assets/build/index.js:118
msgid "%1$s entries analyzed · %2$s orphans · %3$s internal links"
msgstr "%1$s conteúdos analisados · %2$s órfãos · %3$s links internos"

#: assets/build/index.js:118
msgid "See orphans"
msgstr "Ver órfãos"

#: assets/build/index.js:118
msgid "Open an entry"
msgstr "Abrir um conteúdo"

#. translators: %s: section name (Report, Broken links, Settings).
#: assets/build/index.js:119
msgid "Magic Linking · %s"
msgstr "Magic Linking · %s"

#: assets/build/index.js:119
msgid "Orphan entries"
msgstr "Conteúdos órfãos"

#: assets/build/index.js:119
msgid "Only the links written inside each entry’s content are counted. Links in menus, widgets and theme templates are not."
msgstr "São contados apenas os links escritos dentro do conteúdo de cada publicação. Links em menus, widgets e templates do tema não são contados."

#. translators: %s: WP-CLI command.
#: assets/build/index.js:120
msgid "You can also run the analysis from the terminal: %s"
msgstr "Você também pode executar a análise pelo terminal: %s"
