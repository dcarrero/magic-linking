msgid "That text is already linked."
msgstr "Ese texto ya está enlazado."

#: src/Content/Linker.php:78
msgid "This text is a heading and links in headings are not allowed."
msgstr "Este texto es un encabezado y los enlaces en encabezados no están permitidos."

#: src/Content/Linker.php:81
msgid "The anchor includes a shortcode, code or a line break and cannot be linked safely."
msgstr "El ancla incluye un shortcode, código o un salto de línea y no se puede enlazar con seguridad."

#: src/Content/Linker.php:102
msgid "The anchor crosses text formatting (bold, italics…) and cannot be linked without breaking it."
msgstr "El ancla cruza el formato del texto (negrita, cursiva…) y no se puede enlazar sin romperlo."

