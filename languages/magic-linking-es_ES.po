msgstr[1] "No se han podido aplicar %d cambios por sí solos."

#: src/Cli/Command.php:653
msgid "Group redone."
msgstr "Lote rehecho."

#: src/Cli/Command.php:653
msgid "Group undone."
msgstr "Lote deshecho."

#: src/Cli/Command.php:664
msgid "The history never expires with the current setting; nothing to delete."
msgstr "Con el ajuste actual el historial no caduca nunca; no hay nada que borrar."

