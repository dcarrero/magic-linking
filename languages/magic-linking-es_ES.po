#. Plugin Name of the plugin
#: magic-linking.php
msgid "Magic Linking – Internal Links"
msgstr "Magic Linking – Internal Links"

#. Plugin URI of the plugin
#: magic-linking.php
msgid "https://magiclinking.com"
msgstr "https://magiclinking.com"

#. Description of the plugin
#: magic-linking.php
msgid "Internal link suggestions in the editor. Link in one click, check that nothing else changes, undo from History. Plus orphan and broken link reports."
msgstr "Sugerencias de enlaces internos en el editor. Enlaza con un clic, comprueba que no cambia nada más y deshaz desde el Historial. Además, informe de huérfanas y enlaces rotos."

#. Author of the plugin
#: magic-linking.php
msgid "Color Vivo"
msgstr "Color Vivo"

#. Author URI of the plugin
