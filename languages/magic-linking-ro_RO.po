#: src/Cli/RulesCommand.php:230
#, php-format
msgid "%1$d entries shown. Continue with --after=%2$d"
msgstr "Se afișează %1$d intrări. Continuă cu --after=%2$d"

#: src/Cli/RulesCommand.php:254 src/Rest/RulesController.php:646
msgid "That rule or entry does not exist."
msgstr "Regula sau intrarea nu există."

#: src/Cli/RulesCommand.php:260
msgid "Nothing to link."
msgstr "Nu este nimic de legat."

#: src/Cli/RulesCommand.php:267
msgid "Nothing was written. Add --yes to add these links."
msgstr "Nu am scris nimic. Adaugă --yes pentru a adăuga aceste legături."

#: src/Cli/RulesCommand.php:278 src/Cli/RulesCommand.php:319
#: assets/build/index.js:94
