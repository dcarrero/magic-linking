msgstr "S’ha posat en cua el procés %d. S’executarà en segon pla amb Action Scheduler."

#: src/Cli/Command.php:194
msgid "Analyzing entries"
msgstr "S’estan analitzant les entrades"

#. translators: 1: new or modified entries, 2: unchanged entries skipped.
#: src/Cli/Command.php:210
#, php-format
msgid "%1$d new or modified, %2$d unchanged and skipped."
