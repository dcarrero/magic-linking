#. Plugin Name of the plugin
#: magic-linking.php
msgid "Magic Linking – Internal Links"
msgstr "Magic Linking – Internal Links"

#. Plugin URI of the plugin
#: magic-linking.php
msgid "https://magiclinking.com"
msgstr "https://magiclinking.com"

#. Description of the plugin
#: magic-linking.php
msgid "Internal link suggestions in the editor. Link in one click, check that nothing else changes, undo from History. Plus orphan and broken link reports."
msgstr "Suggeriments d’enllaços interns a l’editor. Enllaça amb un clic, comprova que no canvia res més i desfés des de l’Historial. A més, informes d’entrades òrfenes i d’enllaços trencats."

#. Author of the plugin
#: magic-linking.php
msgid "Color Vivo"
msgstr "Color Vivo"

#. Author URI of the plugin
