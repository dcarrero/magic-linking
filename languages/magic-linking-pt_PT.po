#. translators: %s: tokens one AI request needs, formatted.
#: src/Rest/AiController.php:271
#, php-format
msgid "The daily AI limit you set is lower than what one request needs (about %s tokens); raise it in Settings → AI. Showing suggestions without AI."
msgstr "O limite diário de IA que definiu é inferior ao que um pedido precisa (cerca de %s tokens); aumente-o em Definições → IA. A mostrar as sugestões sem IA."

#: src/Rest/AiController.php:275
msgid "You are asking for AI too often; wait a minute and try again. Showing suggestions without AI."
msgstr "Está a pedir IA com demasiada frequência; aguarde um minuto e tente novamente. A mostrar as sugestões sem IA."

#: src/Rest/AiController.php:277
msgid "There is no AI connected on this site, so the suggestions are shown without AI."
msgstr "Este site não tem IA ligada, por isso as sugestões são mostradas sem IA."

#: src/Rest/AiController.php:279
msgid "AI is turned off for this action on this site; showing suggestions without AI."
msgstr "A IA está desativada para esta ação neste site; a mostrar as sugestões sem IA."

#: src/Rest/AiController.php:281
msgid "The daily AI limit you set has been reached; showing suggestions without AI. It will be available again tomorrow."
msgstr "Atingiu o limite diário de IA que definiu; a mostrar as sugestões sem IA. Voltará a estar disponível amanhã."

#: src/Rest/AiController.php:283
msgid "The AI provider took too long to answer; showing suggestions without AI. Try again, or pick a faster model in Settings → AI."
msgstr "O fornecedor de IA demorou demasiado a responder; as sugestões são apresentadas sem IA. Tente novamente ou escolha um modelo mais rápido em Definições → IA."

