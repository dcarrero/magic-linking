<?xml version="1.0"?>
<ruleset name="MagicLinking">
	<description>WordPress Coding Standards para Magic Linking.</description>

	<file>magic-linking.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<file>tests/php</file>

	<!-- Sustituto de WP-CLI para PHPStan y las pruebas: no es código del plugin. -->
	<exclude-pattern>tests/php/stubs/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.9"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- PSR-4: ficheros con el nombre de la clase, no class-*.php. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="magic-linking"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="magiclinking"/>
				<element value="MagicLinking"/>
			</property>
		</properties>
		<!-- Las pruebas siguen las convenciones de PHPUnit. -->
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>

	<!-- En las pruebas se consulta la base de datos a propósito para comprobar lo que queda escrito. -->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
</ruleset>
