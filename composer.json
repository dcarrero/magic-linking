{
	"name": "colorvivo/magic-linking",
	"description": "Internal links report for WordPress: orphan pages, under-linked and over-linked entries, broken internal links.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1",
		"woocommerce/action-scheduler": "~4.2.0"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"autoload": {
		"psr-4": {
			"MagicLinking\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"MagicLinking\\Tests\\": "tests/php/"
		}
	},
	"config": {
		"platform": {
			"php": "8.1.0"
		},
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"scripts": {
		"test": "phpunit --testsuite unit",
		"test:integration": "npx wp-env run tests-cli --env-cwd=wp-content/plugins/magiclinking-wordpress-plugin vendor/bin/phpunit --testsuite integration",
		"lint": [
			"phpcs",
			"phpstan analyse --memory-limit=1G --no-progress"
		],
		"lint:fix": "phpcbf"
	}
}
