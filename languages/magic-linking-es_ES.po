msgstr "Enlace quitado de nuevo."

#: src/History/Redo.php:116
msgid "Link added again."
msgstr "Enlace añadido de nuevo."

#: src/History/Undo.php:125
msgid "This change was already undone."
msgstr "Este cambio ya estaba deshecho."

#: src/History/Undo.php:145
msgid "The post was edited afterwards: only the link was removed."
msgstr "La entrada se había editado después: se ha quitado solo el enlace."

#: src/History/Undo.php:146
msgid "The post was edited afterwards: only this link was put back as it was."
msgstr "La entrada se editó después: solo se ha devuelto este enlace a como estaba."

#: src/History/Undo.php:147
msgid "The link is no longer in the post."
msgstr "El enlace ya no está en la entrada."

#: src/History/Undo.php:192
