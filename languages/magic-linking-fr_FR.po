#: src/History/Redo.php:70
msgid "This link has not been undone, so there is nothing to redo."
msgstr "Ce lien n’a pas été annulé, il n’y a donc rien à rétablir."

#: src/History/Redo.php:74
msgid "This link was already added again."
msgstr "Ce lien avait déjà été rajouté."

#: src/History/Redo.php:93
msgid "This post was edited afterwards; add the link again by hand."
msgstr "Cette publication a été modifiée depuis ; rajoutez le lien à la main."

#: src/History/Redo.php:94
msgid "This post was edited afterwards; fix the link again by hand."
msgstr "Cette publication a été modifiée depuis ; corrigez à nouveau le lien à la main."

#: src/History/Redo.php:113
msgid "Destination changed again."
msgstr "Destination à nouveau modifiée."

#: src/History/Redo.php:114
msgid "Link removed again."
msgstr "Lien à nouveau supprimé."

#: src/History/Redo.php:117
msgid "Link added again."
msgstr "Lien rajouté."

#: src/History/Undo.php:170
msgid "This change was already undone."
msgstr "Cette modification avait déjà été annulée."

#: src/History/Undo.php:192
msgid "The post was edited afterwards: only the link was removed."
msgstr "La publication avait été modifiée depuis : seul le lien a été retiré."

#: src/History/Undo.php:193
msgid "The post was edited afterwards: only this link was put back as it was."
msgstr "La publication a été modifiée depuis : seul ce lien a été remis comme avant."

#: src/History/Undo.php:194
msgid "The link is no longer in the post."
msgstr "Le lien ne se trouve plus dans la publication."

#: src/History/Undo.php:239
msgid "The change could not be confirmed as only removing the link; nothing was written."
msgstr "Impossible de confirmer que la modification se limite au retrait du lien ; rien n’a été écrit."

#: src/History/Undo.php:240
msgid "The change could not be confirmed as only restoring the link; nothing was written."
msgstr "Il n’a pas été possible de confirmer que la modification se limite à la restauration du lien ; rien n’a été écrit."

#: src/History/Undo.php:397
msgid "Destination restored."
msgstr "Destination restaurée."

#: src/History/Undo.php:399
msgid "Link put back."
msgstr "Lien remis en place."

#: src/History/Undo.php:401
msgid "Link undone."
msgstr "Lien annulé."

#: src/History/Undo.php:413
msgid "This post was edited afterwards; restore the link address by hand."
msgstr "Cette publication a été modifiée depuis ; restaurez l’adresse du lien à la main."

#: src/History/Undo.php:415
msgid "This post was edited afterwards; put the link back by hand."
msgstr "Cette publication a été modifiée depuis ; remettez le lien en place à la main."

#: src/History/Undo.php:417
msgid "This post was edited afterwards; remove the link by hand."
msgstr "Cette publication a été modifiée depuis ; retirez le lien à la main."

