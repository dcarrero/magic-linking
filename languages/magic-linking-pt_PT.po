#: src/Content/InsertRequest.php:115
msgid "The anchor is not part of the sentence."
msgstr "A âncora não faz parte da frase."

#: src/Content/Linker.php:56
msgid "The anchor cannot be empty or start or end with a space."
msgstr "A âncora não pode estar vazia nem começar ou terminar com um espaço."

#: src/Content/Linker.php:96
msgid "That text is already linked."
msgstr "Esse texto já tem uma ligação."

#: src/Content/Linker.php:99
msgid "This text is a heading and links in headings are not allowed."
msgstr "Este texto é um título e não são permitidas ligações em títulos."

#: src/Content/Linker.php:103
msgid "This text is the citation of a quote and is not linked."
msgstr "Este texto é a fonte de uma citação e não recebe ligação."

#: src/Content/Linker.php:106
msgid "This text is in a quote and links in quotes are not allowed."
msgstr "Este texto está numa citação e não são permitidas ligações em citações."

#: src/Content/Linker.php:109
msgid "This text is in a table and links in tables are not allowed."
msgstr "Este texto está numa tabela e não são permitidas ligações em tabelas."

#: src/Content/Linker.php:112
msgid "The anchor includes a shortcode, code or a line break and cannot be linked safely."
msgstr "A âncora inclui um shortcode, código ou uma quebra de linha e não pode receber uma ligação em segurança."

#: src/Content/Linker.php:133
msgid "The anchor crosses text formatting (bold, italics…) and cannot be linked without breaking it."
msgstr "A âncora atravessa a formatação do texto (negrito, itálico…) e não pode receber uma ligação sem a quebrar."

#: src/Content/Linker.php:155 src/Content/LinkFixer.php:52
msgid "The link address is not valid."
msgstr "O endereço da ligação não é válido."

#: src/Content/LinkFixer.php:93
msgid "The post contains markup (nested links, scripts, styles…) that cannot be scanned safely, so it was left untouched."
msgstr "O conteúdo tem marcação (ligações aninhadas, scripts, estilos…) que não pode ser analisada com segurança, por isso ficou intacto."

#: src/Content/LinkFixer.php:110
msgid "The post no longer matches the list (the link was moved, edited or is not stored in its content). Nothing was changed; reload the list."
msgstr "O conteúdo já não corresponde à lista (a ligação foi movida, editada ou não está guardada no conteúdo). Nada foi alterado; volte a carregar a lista."

#: src/Content/LinkFixer.php:128
msgid "The link address could not be changed safely, so the post was left untouched."
msgstr "Não foi possível alterar o endereço da ligação com segurança, por isso o conteúdo ficou intacto."

#: src/Content/LinkFixer.php:173
msgid "Removing the link would break this block (a button, an image…). Change its destination instead, or edit the entry."
msgstr "Remover a ligação danificaria este bloco (um botão, uma imagem…). Altere antes o destino ou edite o conteúdo."

#: src/Content/LinkFixer.php:182
msgid "The address of this link is also stored in the settings of its block, so it is not changed here. Edit the entry instead."
msgstr "O endereço desta ligação também está guardado nas definições do seu bloco, por isso não é alterado aqui. Edite antes o conteúdo."

