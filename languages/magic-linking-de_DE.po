msgstr[1] "%d Änderungen konnten nicht einzeln angewendet werden."

#: src/Cli/Command.php:653
msgid "Group redone."
msgstr "Gruppe wiederhergestellt."

#: src/Cli/Command.php:653
msgid "Group undone."
msgstr "Gruppe rückgängig gemacht."

