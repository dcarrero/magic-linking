msgid "WordPress could not save the post; nothing was changed."
msgstr "WordPress no ha podido guardar la entrada; no se ha cambiado nada."

#: src/Content/PostWriter.php:293
msgid "This post is open in your editor (maybe in another tab); add the link from there or close it and try again."
msgstr "Esta entrada está abierta en tu editor (quizá en otra pestaña); añade el enlace desde allí o ciérrala y vuelve a intentarlo."

#: src/Content/PostWriter.php:297
msgid "someone else"
msgstr "otra persona"

#. translators: %s: name of the person who has the post open.
#: src/Content/PostWriter.php:303
#, php-format
msgid "This post has just been opened by %s; try again later."
msgstr "%s acaba de abrir esta entrada; inténtalo más tarde."

#. translators: %s: name of the person who has the post open.
#: src/Content/PostWriter.php:305
#, php-format
msgid "This post is being edited by %s; try again later."
msgstr "Esta entrada la está editando %s; inténtalo más tarde."

