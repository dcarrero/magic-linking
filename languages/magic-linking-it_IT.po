msgid "There is no such process."
msgstr "Non esiste questo processo."

#: src/Cli/Command.php:496 src/Rest/HistoryController.php:285
#: src/Rest/JobsController.php:170 src/Rest/JobsController.php:185
msgid "That process cannot be changed in its current state."
msgstr "Quel processo non può essere modificato nel suo stato attuale."

#. translators: 1: process ID, 2: new state.
#: src/Cli/Command.php:502
#, php-format
msgid "Process %1$d is now %2$s."
msgstr "Il processo %1$d ora è %2$s."

#. translators: %s: batch ID.
#: src/Cli/Command.php:584
#, php-format
msgid "There are more batches. Continue with: wp magic-linking history list --before=%s"
msgstr "Ci sono altri gruppi. Continua con: wp magic-linking history list --before=%s"

#: src/Cli/Command.php:601
msgid "Unknown action. Use: list, undo, redo or purge."
msgstr "Azione sconosciuta. Usa: list, undo, redo o purge."

#: src/Cli/Command.php:613
msgid "There is no such group in the history (or you cannot edit all of its entries)."
msgstr "Nella cronologia non esiste questo gruppo (oppure non puoi modificare tutti i suoi contenuti)."

#: src/Cli/Command.php:617 src/Rest/HistoryController.php:485
msgid "This batch is being processed in the background. Wait for it to finish or cancel it."
msgstr "Questo gruppo è in elaborazione in background. Attendi che finisca oppure annullalo."

#: src/Cli/Command.php:622 src/Rest/HistoryController.php:499
#: src/Rest/SuggestionsController.php:383
msgid "You do not have permission to edit one of the entries involved."
msgstr "Non hai i permessi per modificare uno dei contenuti coinvolti."

#. translators: %d: number of changes.
#: src/Cli/Command.php:646
#, php-format
msgid "%d change could not be applied by itself."
msgid_plural "%d changes could not be applied by themselves."
msgstr[0] "%d modifica non ha potuto essere applicata da sola."
msgstr[1] "%d modifiche non hanno potuto essere applicate da sole."

#: src/Cli/Command.php:653
msgid "Group redone."
msgstr "Gruppo ripetuto."

#: src/Cli/Command.php:653
msgid "Group undone."
msgstr "Gruppo annullato."

#: src/Cli/Command.php:664
msgid "The history never expires with the current setting; nothing to delete."
msgstr "Con l'impostazione attuale la cronologia non scade mai; non c'è nulla da eliminare."

#. translators: %d: number of history rows.
#: src/Cli/Command.php:673
#, php-format
msgid "%d history row has expired."
msgid_plural "%d history rows have expired."
msgstr[0] "%d riga della cronologia è scaduta."
msgstr[1] "%d righe della cronologia sono scadute."

#: src/Cli/Command.php:682
msgid "Nothing has expired."
msgstr "Non è scaduto nulla."

#. translators: %d: number of history rows.
#: src/Cli/Command.php:692
#, php-format
msgid "%d history row deleted."
msgid_plural "%d history rows deleted."
msgstr[0] "%d riga della cronologia eliminata."
msgstr[1] "%d righe della cronologia eliminate."

#: src/Cli/Command.php:706 src/Rest/SuggestionsController.php:552
msgid "That entry does not exist."
msgstr "Quel contenuto non esiste."

#: src/Cli/Command.php:713
msgid "Entry analyzed."
msgstr "Contenuto analizzato."

#: src/Cli/Command.php:716
msgid "Nothing changed since the last analysis. Use --force to analyze it again."
msgstr "Non è cambiato nulla dall'ultima analisi. Usa --force per analizzarlo di nuovo."

#: src/Cli/Command.php:719
msgid "The entry is not published or is not of a chosen content type: it was taken out of the report."
msgstr "Il contenuto non è pubblicato o non è di un tipo di contenuto scelto: è stato tolto dal report."

#: src/Cli/Command.php:722
msgid "The entry is not published or is not of a chosen content type, so it is not analyzed."
msgstr "Il contenuto non è pubblicato o non è di un tipo di contenuto scelto, quindi non viene analizzato."

#: src/Cli/Command.php:735
msgid "Could not open the output."
msgstr "Impossibile aprire l'output."

#: src/Content/BlockEditor.php:46
msgid "The block structure of this post could not be read, so it was left untouched."
msgstr "Non è stato possibile leggere la struttura a blocchi di questo articolo, quindi è stato lasciato intatto."

#: src/Content/BlockEditor.php:70
msgid "The block contains markup (script, styles…) that cannot be scanned safely."
msgstr "Il blocco contiene markup (script, stili…) che non può essere esaminato in sicurezza."

#: src/Content/BlockEditor.php:90 src/Content/BlockEditor.php:129
#: src/Content/ClassicEditor.php:59 src/Content/PostWriter.php:181
msgid "The text has changed."
msgstr "Il testo è cambiato."

#: src/Content/BlockEditor.php:96
msgid "The text of this block comes from another source (data binding) and cannot be edited here."
msgstr "Il testo di questo blocco proviene da un'altra fonte (associazione di dati) e non può essere modificato qui."

#: src/Content/BlockEditor.php:172
msgid "This text belongs to a reusable block: edit the original pattern."
msgstr "Questo testo appartiene a un blocco riutilizzabile: modifica il pattern originale."

#: src/Content/BlockEditor.php:175
msgid "This text is in a block where links are not inserted automatically."
msgstr "Questo testo è in un blocco in cui i link non vengono inseriti automaticamente."

#: src/Content/ClassicEditor.php:45
msgid "The post contains markup (script, styles…) that cannot be scanned safely."
msgstr "L'articolo contiene markup (script, stili…) che non può essere esaminato in sicurezza."

#: src/Content/Inserter.php:88
msgid "All the links of one write must be for the same post and the same user."
msgstr "Tutti i link di una stessa scrittura devono riguardare lo stesso articolo e lo stesso utente."

#: src/Content/Inserter.php:97
msgid "This content type is not one that Magic Linking analyzes."
msgstr "Questo tipo di contenuto non è tra quelli che Magic Linking analizza."

#: src/Content/Inserter.php:159 src/History/Redo.php:150
msgid "The change could not be confirmed as only the link; nothing was written."
msgstr "Non è stato possibile confermare che la modifica riguardi solo il link; non è stato scritto nulla."

#: src/Content/Inserter.php:183 src/History/Redo.php:156
#: src/History/Undo.php:184
msgid "The change history could not be saved; nothing was written."
msgstr "Impossibile salvare la cronologia delle modifiche; non è stato scritto nulla."

#: src/Content/InsertRequest.php:75
msgid "The anchor is not part of the sentence."
msgstr "Il testo di ancoraggio non fa parte della frase."

#: src/Content/Linker.php:46
msgid "The anchor cannot be empty or start or end with a space."
msgstr "Il testo di ancoraggio non può essere vuoto né iniziare o finire con uno spazio."

#: src/Content/Linker.php:75
msgid "That text is already linked."
msgstr "Quel testo è già collegato."

#: src/Content/Linker.php:78
msgid "This text is a heading and links in headings are not allowed."
msgstr "Questo testo è un titolo e non sono consentiti link nei titoli."

#: src/Content/Linker.php:81
msgid "The anchor includes a shortcode, code or a line break and cannot be linked safely."
msgstr "Il testo di ancoraggio include uno shortcode, del codice o un a capo e non può essere collegato in sicurezza."

#: src/Content/Linker.php:102
msgid "The anchor crosses text formatting (bold, italics…) and cannot be linked without breaking it."
msgstr "Il testo di ancoraggio attraversa una formattazione (grassetto, corsivo…) e non può essere collegato senza romperla."

#: src/Content/Linker.php:124
msgid "The link address is not valid."
msgstr "L'indirizzo del link non è valido."

#: src/Content/PostWriter.php:93
msgid "The post does not exist or is in the trash."
msgstr "L'articolo non esiste o è nel cestino."

#: src/Content/PostWriter.php:98
msgid "You do not have permission to edit this post."
msgstr "Non hai i permessi per modificare questo articolo."

#: src/Content/PostWriter.php:136
msgid "Another change is being applied to this post; try again in a moment."
msgstr "È in corso un'altra modifica su questo articolo; riprova tra un momento."

#: src/Content/PostWriter.php:212 src/History/BatchJob.php:275
msgid "WordPress could not save the post; nothing was changed."
msgstr "WordPress non è riuscito a salvare l'articolo; non è stato modificato nulla."

#: src/Content/PostWriter.php:293
msgid "This post is open in your editor (maybe in another tab); add the link from there or close it and try again."
msgstr "Questo articolo è aperto nel tuo editor (forse in un'altra scheda); aggiungi il link da lì oppure chiudilo e riprova."

#: src/Content/PostWriter.php:297
msgid "someone else"
msgstr "un'altra persona"

#. translators: %s: name of the person who has the post open.
#: src/Content/PostWriter.php:303
#, php-format
msgid "This post has just been opened by %s; try again later."
msgstr "Questo articolo è appena stato aperto da %s; riprova più tardi."

#. translators: %s: name of the person who has the post open.
#: src/Content/PostWriter.php:305
#, php-format
msgid "This post is being edited by %s; try again later."
msgstr "Questo articolo è in fase di modifica da parte di %s; riprova più tardi."

#: src/Content/PostWriter.php:318
msgid "WordPress altered the content when saving it (security filters); the original was restored and the link was not inserted."
msgstr "WordPress ha modificato il contenuto al salvataggio (filtri di sicurezza); è stato ripristinato l'originale e il link non è stato inserito."

#: src/Content/PostWriter.php:319
msgid "WordPress would alter the content when saving it (security filters); nothing was written and the link was not inserted."
msgstr "WordPress modificherebbe il contenuto al salvataggio (filtri di sicurezza); non è stato scritto nulla e il link non è stato inserito."

