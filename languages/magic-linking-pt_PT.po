msgid "Could not open the output."
msgstr "Não foi possível abrir a saída."

#: src/Content/BlockEditor.php:57 src/Content/LinkFixer.php:58
msgid "The block structure of this post could not be read, so it was left untouched."
msgstr "Não foi possível ler a estrutura de blocos deste conteúdo, por isso não foi alterado."

#: src/Content/BlockEditor.php:82
msgid "The block contains markup (script, styles…) that cannot be scanned safely."
msgstr "O bloco contém código (scripts, estilos…) que não pode ser analisado em segurança."

#: src/Content/BlockEditor.php:102 src/Content/BlockEditor.php:199
#: src/Content/ClassicEditor.php:59 src/Content/PostWriter.php:196
msgid "The text has changed."
msgstr "O texto mudou."

#: src/Content/BlockEditor.php:108 src/Content/LinkFixer.php:167
msgid "The text of this block comes from another source (data binding) and cannot be edited here."
msgstr "O texto deste bloco vem de outra fonte (ligação de dados) e não pode ser editado aqui."

#: src/Content/BlockEditor.php:283
msgid "This text belongs to a reusable block: edit the original pattern."
msgstr "Este texto pertence a um bloco reutilizável: edite o padrão original."

#: src/Content/BlockEditor.php:286
msgid "This text is in a block where links are not inserted automatically."
msgstr "Este texto está num bloco onde as ligações não são inseridas automaticamente."

#: src/Content/ClassicEditor.php:45
msgid "The post contains markup (script, styles…) that cannot be scanned safely."
msgstr "O conteúdo contém código (scripts, estilos…) que não pode ser analisado em segurança."

#: src/Content/Destination.php:43 src/Content/Destination.php:51
#: src/Rest/FixController.php:251
msgid "The destination is not a published entry that can be linked."
msgstr "O destino não é um conteúdo publicado que possa receber uma ligação."

#: src/Content/Destination.php:46
msgid "The destination is in a different language, so no link is added."
msgstr "O destino está noutro idioma, por isso não é adicionada nenhuma ligação."

#: src/Content/Inserter.php:126
msgid "All the links of one write must be for the same post and the same user."
msgstr "Todas as ligações de uma mesma gravação têm de ser para o mesmo conteúdo e o mesmo utilizador."

#: src/Content/Inserter.php:140 src/Content/Repairer.php:58
msgid "This content type is not one that Magic Linking analyzes."
msgstr "Este tipo de conteúdo não é um dos que o Magic Linking analisa."

#: src/Content/Inserter.php:202 src/Content/Repairer.php:110
#: src/History/Redo.php:267
msgid "The change could not be confirmed as only the link; nothing was written."
msgstr "Não foi possível confirmar que a alteração afeta apenas a ligação; nada foi escrito."

#: src/Content/Inserter.php:226 src/Content/Repairer.php:117
#: src/History/Redo.php:273 src/History/Undo.php:256
msgid "The change history could not be saved; nothing was written."
msgstr "Não foi possível guardar o histórico de alterações; nada foi escrito."

#: src/Content/InsertRequest.php:102
msgid "The anchor is not part of the sentence."
msgstr "A âncora não faz parte da frase."

#: src/Content/Linker.php:56
msgid "The anchor cannot be empty or start or end with a space."
msgstr "A âncora não pode estar vazia nem começar ou terminar com um espaço."

#: src/Content/Linker.php:96
msgid "That text is already linked."
msgstr "Esse texto já tem uma ligação."

#: src/Content/Linker.php:99
msgid "This text is a heading and links in headings are not allowed."
msgstr "Este texto é um título e não são permitidas ligações em títulos."

#: src/Content/Linker.php:103
msgid "This text is the citation of a quote and is not linked."
msgstr "Este texto é a fonte de uma citação e não recebe ligação."

#: src/Content/Linker.php:106
msgid "This text is in a quote and links in quotes are not allowed."
msgstr "Este texto está numa citação e não são permitidas ligações em citações."

#: src/Content/Linker.php:109
msgid "This text is in a table and links in tables are not allowed."
msgstr "Este texto está numa tabela e não são permitidas ligações em tabelas."

#: src/Content/Linker.php:112
msgid "The anchor includes a shortcode, code or a line break and cannot be linked safely."
msgstr "A âncora inclui um shortcode, código ou uma quebra de linha e não pode receber uma ligação em segurança."

#: src/Content/Linker.php:133
msgid "The anchor crosses text formatting (bold, italics…) and cannot be linked without breaking it."
msgstr "A âncora atravessa a formatação do texto (negrito, itálico…) e não pode receber uma ligação sem a quebrar."

#: src/Content/Linker.php:155 src/Content/LinkFixer.php:52
msgid "The link address is not valid."
msgstr "O endereço da ligação não é válido."

#: src/Content/LinkFixer.php:93
msgid "The post contains markup (nested links, scripts, styles…) that cannot be scanned safely, so it was left untouched."
msgstr "O conteúdo tem marcação (ligações aninhadas, scripts, estilos…) que não pode ser analisada com segurança, por isso ficou intacto."

#: src/Content/LinkFixer.php:110
msgid "The post no longer matches the list (the link was moved, edited or is not stored in its content). Nothing was changed; reload the list."
msgstr "O conteúdo já não corresponde à lista (a ligação foi movida, editada ou não está guardada no conteúdo). Nada foi alterado; volte a carregar a lista."

#: src/Content/LinkFixer.php:128
msgid "The link address could not be changed safely, so the post was left untouched."
msgstr "Não foi possível alterar o endereço da ligação com segurança, por isso o conteúdo ficou intacto."

#: src/Content/LinkFixer.php:173
msgid "Removing the link would break this block (a button, an image…). Change its destination instead, or edit the entry."
msgstr "Remover a ligação danificaria este bloco (um botão, uma imagem…). Altere antes o destino ou edite o conteúdo."

#: src/Content/LinkFixer.php:182
msgid "The address of this link is also stored in the settings of its block, so it is not changed here. Edit the entry instead."
msgstr "O endereço desta ligação também está guardado nas definições do seu bloco, por isso não é alterado aqui. Edite antes o conteúdo."

#: src/Content/PostWriter.php:100
msgid "The post does not exist or is in the trash."
msgstr "O conteúdo não existe ou está no lixo."

#: src/Content/PostWriter.php:105
msgid "You do not have permission to edit this post."
msgstr "Não tem permissão para editar este conteúdo."

#: src/Content/PostWriter.php:148
msgid "Another change is being applied to this post; try again in a moment."
msgstr "Está a ser aplicada outra alteração a este conteúdo; tente novamente daqui a pouco."

#: src/Content/PostWriter.php:227 src/History/BatchJob.php:383
#: src/History/BatchJob.php:453 src/History/Redo.php:193
#: src/History/Undo.php:117
msgid "WordPress could not save the post; nothing was changed."
msgstr "O WordPress não conseguiu guardar o conteúdo; nada foi alterado."

#: src/Content/PostWriter.php:308
msgid "This post is open in your editor (maybe in another tab); add the link from there or close it and try again."
msgstr "Este conteúdo está aberto no seu editor (talvez noutro separador); adicione a ligação a partir daí ou feche-o e tente novamente."

#: src/Content/PostWriter.php:312
msgid "someone else"
msgstr "outra pessoa"

#. translators: %s: name of the person who has the post open.
#: src/Content/PostWriter.php:318
#, php-format
msgid "This post has just been opened by %s; try again later."
msgstr "Este conteúdo acabou de ser aberto por %s; tente novamente mais tarde."

#. translators: %s: name of the person who has the post open.
#: src/Content/PostWriter.php:320
#, php-format
msgid "This post is being edited by %s; try again later."
msgstr "Este conteúdo está a ser editado por %s; tente novamente mais tarde."

#: src/Content/PostWriter.php:333
msgid "WordPress altered the content when saving it (security filters); the original was restored and the link was not inserted."
msgstr "O WordPress alterou o conteúdo ao guardá-lo (filtros de segurança); o original foi reposto e a ligação não foi inserida."

#: src/Content/PostWriter.php:334
msgid "WordPress would alter the content when saving it (security filters); nothing was written and the link was not inserted."
msgstr "O WordPress alteraria o conteúdo ao guardá-lo (filtros de segurança); nada foi escrito e a ligação não foi inserida."

#: src/Graph/BrokenReason.php:31
