msgstr "Quel processo non esiste."

#. translators: %s: comma-separated list of shared terms.
#: src/Rest/SuggestionPresenter.php:146
#, php-format
msgid "They share: %s"
msgstr "Hanno in comune: %s"

#: src/Rest/SuggestionPresenter.php:149
msgid "The anchor matches the title of the destination"
msgstr "Il testo di ancoraggio corrisponde al titolo della destinazione"

#: src/Rest/SuggestionPresenter.php:152
msgid "The anchor matches the focus keyword of the destination"
msgstr "Il testo di ancoraggio corrisponde alla parola chiave principale della destinazione"

#: src/Rest/SuggestionPresenter.php:155
msgid "The destination is an orphan (0 inbound links)"
msgstr "La destinazione è orfana (0 link in entrata)"

#: src/Rest/SuggestionPresenter.php:158
msgid "Very similar in meaning"
msgstr "Significato molto simile"

#: src/Rest/SuggestionsController.php:243
msgid "The content is too long to analyze."
msgstr "Il contenuto è troppo lungo per essere analizzato."

#: src/Rest/SuggestionsController.php:375
msgid "Each link needs the post, the destination, the sentence, the offset and the anchor."
msgstr "Ogni link ha bisogno dell'articolo, della destinazione, della frase, della posizione e del testo di ancoraggio."

#: src/Rest/SuggestionsController.php:430
msgid "The link could not be saved; nothing was changed."
msgstr "Impossibile salvare il link; non è stato modificato nulla."

#: src/Rest/SuggestionsController.php:502
#: src/Rest/SuggestionsController.php:510
