#. Plugin Name of the plugin
#: magic-linking.php
msgid "Magic Linking – Internal Links"
msgstr "Magic Linking – interne links"

#. Plugin URI of the plugin
#: magic-linking.php
msgid "https://magiclinking.com"
msgstr "https://magiclinking.com"

#. Description of the plugin
#: magic-linking.php
msgid "Internal link suggestions in the editor. Link in one click, check that nothing else changes, undo from History. Plus orphan and broken link reports."
msgstr "Interne linksuggesties in de editor. Link met één klik, controleer dat er verder niets verandert en maak ongedaan via Geschiedenis. Plus rapporten over weesitems en defecte links."

#. Author of the plugin
#: magic-linking.php
msgid "Color Vivo"
msgstr "Color Vivo"

#. Author URI of the plugin
