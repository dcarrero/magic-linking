msgid_plural "%1$d links added (batch %2$s). Undo with: wp magic-linking history undo %2$s"
msgstr[0] "Am adăugat %1$d legătură (lotul %2$s). Anulează cu: wp magic-linking history undo %2$s"
msgstr[1] "Am adăugat %1$d legături (lotul %2$s). Anulează cu: wp magic-linking history undo %2$s"
msgstr[2] "Am adăugat %1$d de legături (lotul %2$s). Anulează cu: wp magic-linking history undo %2$s"

