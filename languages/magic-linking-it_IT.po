msgstr "Vedi nella Cronologia"

#. translators: %s: title of the destination.
#: assets/build/classic.js:3 assets/build/editor.js:3
msgid "Link to “%s”"
msgstr "Collega a «%s»"

#: assets/build/classic.js:3 assets/build/editor.js:3
msgctxt "button: add the link to the text"
msgid "Link"
msgstr "Collega"

#. translators: %s: title of the destination.
#: assets/build/classic.js:4 assets/build/editor.js:4
msgid "Dismiss the suggestion for “%s”"
msgstr "Ignora il suggerimento per «%s»"

#: assets/build/classic.js:4 assets/build/editor.js:4
msgid "Dismiss"
msgstr "Ignora"

#: assets/build/classic.js:4 assets/build/editor.js:4
msgid "The site has not been analyzed yet, so there are no suggestions. Analyze it from the report and come back."
msgstr "Il sito non è ancora stato analizzato, quindi non ci sono suggerimenti. Analizzalo dal report e poi torna qui."

#: assets/build/classic.js:4 assets/build/editor.js:4
msgid "Open the report"
msgstr "Apri il report"

#: assets/build/classic.js:4 assets/build/editor.js:4
msgid "This entry is not analyzed yet. Save it and refresh in a moment, or check that its content type is analyzed in Settings."
msgstr "Questo contenuto non è ancora stato analizzato. Salvalo e aggiorna tra un momento, oppure controlla nelle Impostazioni che il suo tipo di contenuto venga analizzato."

#: assets/build/classic.js:4 assets/build/editor.js:4
msgid "Other entries can only link to this one once it is published."
msgstr "Gli altri contenuti possono collegarsi a questo solo dopo che è stato pubblicato."

#: assets/build/classic.js:4 assets/build/editor.js:4
msgid "You have dismissed all the suggestions. They come back when you refresh."
msgstr "Hai ignorato tutti i suggerimenti. Ricompaiono quando aggiorni."

#: assets/build/classic.js:4 assets/build/editor.js:4
msgid "There are no suggestions with enough confidence. This usually happens with very short entries or on a topic that has no other content on the site yet."
msgstr "Non ci sono suggerimenti abbastanza affidabili. Di solito succede con contenuti molto brevi o con argomenti di cui il sito non ha ancora altri contenuti."

#: assets/build/classic.js:4 assets/build/editor.js:4
msgid "No other entry has a sentence that fits a link to this one yet."
msgstr "Per ora nessun altro contenuto ha una frase adatta a un link verso questo."

#: assets/build/classic.js:4 assets/build/editor.js:4
msgid "Try again"
msgstr "Riprova"

#: assets/build/classic.js:4 assets/build/editor.js:4
msgid "Looking for suggestions…"
msgstr "Ricerca dei suggerimenti…"

#: assets/build/classic.js:4 assets/build/editor.js:4
msgid "Inbound suggestions pages"
msgstr "Pagine dei suggerimenti in entrata"

#: assets/build/classic.js:4 assets/build/editor.js:4
msgid "Previous"
msgstr "Precedente"

