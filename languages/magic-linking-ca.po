msgstr "El procés no ha acabat. Consulta’n l’estat amb: wp magic-linking status"

#: src/Cli/Command.php:361
msgid "Invalid filter. Use: all, orphans, low, over, broken or excluded."
msgstr "Filtre no vàlid. Utilitza: all, orphans, low, over, broken o excluded."

#: src/Cli/Command.php:364
msgid "Invalid column for --orderby."
msgstr "La columna de --orderby no és vàlida."

#: src/Cli/Command.php:487
msgid "Unknown action. Use: list, pause, resume or cancel."
msgstr "Acció desconeguda. Utilitza: list, pause, resume o cancel."

#: src/Cli/Command.php:492
