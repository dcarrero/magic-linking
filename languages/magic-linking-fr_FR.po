msgstr "Le processus %1$d est maintenant à l’état %2$s."

#. translators: %s: batch ID.
#: src/Cli/Command.php:584
#, php-format
msgid "There are more batches. Continue with: wp magic-linking history list --before=%s"
msgstr "Il reste d’autres lots. Continuez avec : wp magic-linking history list --before=%s"

