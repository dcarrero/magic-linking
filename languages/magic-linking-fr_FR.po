msgid_plural "%d changes could not be applied by themselves."
msgstr[0] "%d modification n’a pas pu être appliquée seule."
msgstr[1] "%d modifications n’ont pas pu être appliquées seules."

#: src/Cli/Command.php:694
msgid "Group redone."
msgstr "Lot rétabli."

#: src/Cli/Command.php:694
msgid "Group undone."
msgstr "Lot annulé."

#: src/Cli/Command.php:705
msgid "The history never expires with the current setting; nothing to delete."
msgstr "Avec le réglage actuel, l’historique n’expire jamais ; rien à supprimer."

#. translators: %d: number of history rows.
#: src/Cli/Command.php:714
#, php-format
msgid "%d history row has expired."
msgid_plural "%d history rows have expired."
msgstr[0] "%d ligne de l’historique a expiré."
msgstr[1] "%d lignes de l’historique ont expiré."

#: src/Cli/Command.php:723
msgid "Nothing has expired."
msgstr "Rien n’a expiré."

#. translators: %d: number of history rows.
#: src/Cli/Command.php:733
#, php-format
msgid "%d history row deleted."
msgid_plural "%d history rows deleted."
msgstr[0] "%d ligne de l’historique supprimée."
msgstr[1] "%d lignes de l’historique supprimées."

