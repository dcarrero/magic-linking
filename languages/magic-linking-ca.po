msgstr "Aquest canvi no existeix."

#: src/Cli/Command.php:694 src/Cli/Command.php:714
#: src/Rest/HistoryController.php:774
msgid "This batch is being processed in the background. Wait for it to finish or cancel it."
msgstr "Aquest lot s’està processant en segon pla. Espera que acabi o cancel·la’l."

#: src/Cli/Command.php:710
msgid "There is no such group in the history (or you cannot edit all of its entries)."
msgstr "No existeix aquest grup a l’historial (o no pots editar-ne totes les entrades)."

#. translators: %d: number of changes.
#: src/Cli/Command.php:755
#, php-format
msgid "%d change could not be applied by itself."
msgid_plural "%d changes could not be applied by themselves."
msgstr[0] "%d canvi no s’ha pogut aplicar per si sol."
msgstr[1] "%d canvis no s’han pogut aplicar per si sols."

#: src/Cli/Command.php:762
msgid "Group redone."
msgstr "S’ha refet el grup."

#: src/Cli/Command.php:762
msgid "Group undone."
msgstr "S’ha desfet el grup."

#: src/Cli/Command.php:773
msgid "The history never expires with the current setting; nothing to delete."
msgstr "Amb el paràmetre actual l’historial no caduca mai; no hi ha res a suprimir."

#. translators: %d: number of history rows.
#: src/Cli/Command.php:782
#, php-format
msgid "%d history row has expired."
msgid_plural "%d history rows have expired."
msgstr[0] "%d fila de l’historial ha caducat."
msgstr[1] "%d files de l’historial han caducat."

#: src/Cli/Command.php:791
msgid "Nothing has expired."
msgstr "No ha caducat res."

#. translators: %d: number of history rows.
#: src/Cli/Command.php:801
#, php-format
msgid "%d history row deleted."
msgid_plural "%d history rows deleted."
msgstr[0] "S’ha suprimit %d fila de l’historial."
msgstr[1] "S’han suprimit %d files de l’historial."

#. translators: %d: number of entries.
#: src/Cli/Command.php:836
#, php-format
msgid "%d entry excluded from the analysis."
msgid_plural "%d entries excluded from the analysis."
msgstr[0] "%d entrada exclosa de l’anàlisi."
msgstr[1] "%d entrades excloses de l’anàlisi."

#. translators: %d: number of entries.
#: src/Cli/Command.php:870
#, php-format
msgid "%d entry included in the analysis again."
msgid_plural "%d entries included in the analysis again."
msgstr[0] "%d entrada tornada a incloure a l’anàlisi."
msgstr[1] "%d entrades tornades a incloure a l’anàlisi."

#: src/Cli/Command.php:888
msgid "That entry does not exist or is not of a chosen content type."
msgstr "Aquesta entrada no existeix o no és d’un tipus de contingut triat."

#: src/Cli/Command.php:904 src/Cli/RulesCommand.php:301
#: src/Rest/AiController.php:196 src/Rest/AnalyzedEntry.php:43
#: src/Rest/DismissalsController.php:141
#: src/Rest/EditorHistoryController.php:95
#: src/Rest/SuggestionsController.php:1030
msgid "That entry does not exist."
msgstr "Aquesta entrada no existeix."

#: src/Cli/Command.php:911
msgid "Entry analyzed."
msgstr "S’ha analitzat l’entrada."

#: src/Cli/Command.php:914
msgid "Nothing changed since the last analysis. Use --force to analyze it again."
msgstr "No ha canviat res des de l’última anàlisi. Utilitza --force per tornar-la a analitzar."

#: src/Cli/Command.php:917
msgid "The entry is not published or is not of a chosen content type: it was taken out of the report."
msgstr "L’entrada no està publicada o no és d’un tipus de contingut triat: s’ha tret de l’informe."

#: src/Cli/Command.php:920
msgid "The entry is not published or is not of a chosen content type, so it is not analyzed."
msgstr "L’entrada no està publicada o no és d’un tipus de contingut triat, per això no s’analitza."

#: src/Cli/Command.php:933
msgid "Could not open the output."
msgstr "No s’ha pogut obrir la sortida."

#: src/Cli/RulesCommand.php:152
msgid "The rule could not be saved."
msgstr "No s’ha pogut desar la regla."

#. translators: %d: rule ID.
#: src/Cli/RulesCommand.php:155
#, php-format
msgid "Rule %d created."
msgstr "S’ha creat la regla %d."

#. translators: %d: rule ID.
#: src/Cli/RulesCommand.php:174
#, php-format
msgid "Rule %d does not exist."
msgstr "La regla %d no existeix."

#. translators: %d: rule ID.
#: src/Cli/RulesCommand.php:177
#, php-format
msgid "Rule %d deleted."
msgstr "S’ha suprimit la regla %d."

#: src/Cli/RulesCommand.php:203
msgid "That rule does not exist."
msgstr "Aquesta regla no existeix."

#: src/Cli/RulesCommand.php:225
msgid "No entry found using the index, which can miss some matches. Run it again with --full to check every entry."
msgstr "No s’ha trobat cap entrada amb l’índex, que pot deixar-se coincidències. Torna-ho a executar amb --full per revisar totes les entrades."

#. translators: %d: number of entries.
#: src/Cli/RulesCommand.php:227
#, php-format
msgid "%d entry where the rule fits."
msgid_plural "%d entries where the rule fits."
msgstr[0] "%d entrada on encaixa la regla."
msgstr[1] "%d entrades on encaixa la regla."

#. translators: 1: number of entries shown, 2: entry ID to continue after.
#: src/Cli/RulesCommand.php:230
#, php-format
msgid "%1$d entries shown. Continue with --after=%2$d"
msgstr "S’han mostrat %1$d entrades. Continua amb --after=%2$d"

#: src/Cli/RulesCommand.php:254 src/Rest/RulesController.php:646
msgid "That rule or entry does not exist."
msgstr "Aquesta regla o entrada no existeix."

#: src/Cli/RulesCommand.php:260
msgid "Nothing to link."
msgstr "No hi ha res a enllaçar."

#: src/Cli/RulesCommand.php:267
msgid "Nothing was written. Add --yes to add these links."
msgstr "No s’ha escrit res. Afegeix --yes per afegir aquests enllaços."

#: src/Cli/RulesCommand.php:278 src/Cli/RulesCommand.php:319
#: assets/build/index.js:94
msgid "Nothing was added."
msgstr "No s’ha afegit res."

#. translators: 1: number of links added, 2: history batch ID.
#: src/Cli/RulesCommand.php:282
#, php-format
msgid "%1$d link added (batch %2$s). Undo with: wp magic-linking history undo %2$s"
msgid_plural "%1$d links added (batch %2$s). Undo with: wp magic-linking history undo %2$s"
msgstr[0] "S’ha afegit %1$d enllaç (lot %2$s). Desfés-ho amb: wp magic-linking history undo %2$s"
msgstr[1] "S’han afegit %1$d enllaços (lot %2$s). Desfés-ho amb: wp magic-linking history undo %2$s"

#. translators: 1: rule ID, 2: reason.
#: src/Cli/RulesCommand.php:311 src/Cli/RulesCommand.php:315
#, php-format
msgid "Rule %1$d: %2$s"
msgstr "Regla %1$d: %2$s"

#. translators: %d: number of links added.
#: src/Cli/RulesCommand.php:322 assets/build/index.js:94
#, php-format
msgid "%d link added."
msgid_plural "%d links added."
msgstr[0] "S’ha afegit %d enllaç."
msgstr[1] "S’han afegit %d enllaços."

#: src/Content/BlockEditor.php:57 src/Content/LinkFixer.php:58
msgid "The block structure of this post could not be read, so it was left untouched."
msgstr "No s’ha pogut llegir l’estructura de blocs d’aquesta entrada, de manera que s’ha deixat intacta."

#: src/Content/BlockEditor.php:82
msgid "The block contains markup (script, styles…) that cannot be scanned safely."
msgstr "El bloc conté marcatge (script, estils…) que no es pot analitzar de manera segura."

#: src/Content/BlockEditor.php:102 src/Content/BlockEditor.php:199
#: src/Content/ClassicEditor.php:59 src/Content/PostWriter.php:211
msgid "The text has changed."
msgstr "El text ha canviat."

#: src/Content/BlockEditor.php:108 src/Content/LinkFixer.php:167
msgid "The text of this block comes from another source (data binding) and cannot be edited here."
msgstr "El text d’aquest bloc ve d’una altra font (vinculació de dades) i no es pot editar aquí."

#: src/Content/BlockEditor.php:283
msgid "This text belongs to a reusable block: edit the original pattern."
msgstr "Aquest text pertany a un bloc reutilitzable: edita el patró original."

#: src/Content/BlockEditor.php:286
msgid "This text is in a block where links are not inserted automatically."
msgstr "Aquest text es troba en un bloc on els enllaços no s’insereixen automàticament."

#: src/Content/ClassicEditor.php:45
msgid "The post contains markup (script, styles…) that cannot be scanned safely."
msgstr "L’entrada conté marcatge (script, estils…) que no es pot analitzar de manera segura."

#: src/Content/Destination.php:43 src/Content/Destination.php:51
#: src/Rest/FixController.php:253 src/Rules/RuleService.php:107
msgid "The destination is not a published entry that can be linked."
msgstr "La destinació no és una entrada publicada que es pugui enllaçar."

#: src/Content/Destination.php:46
msgid "The destination is in a different language, so no link is added."
msgstr "La destinació és en un altre idioma, de manera que no s’afegeix cap enllaç."

#: src/Content/Inserter.php:126
msgid "All the links of one write must be for the same post and the same user."
msgstr "Tots els enllaços d’una mateixa escriptura han de ser de la mateixa entrada i del mateix usuari."

#: src/Content/Inserter.php:140 src/Content/Repairer.php:58
#: src/Rules/RuleService.php:103
msgid "This content type is not one that Magic Linking analyzes."
msgstr "Aquest tipus de contingut no és un dels que analitza Magic Linking."

#: src/Content/Inserter.php:202 src/Content/Repairer.php:110
#: src/History/Redo.php:267
msgid "The change could not be confirmed as only the link; nothing was written."
msgstr "No s’ha pogut confirmar que el canvi sigui només l’enllaç; no s’ha escrit res."

#: src/Content/Inserter.php:226 src/Content/Repairer.php:117
#: src/History/Redo.php:273 src/History/Undo.php:254
msgid "The change history could not be saved; nothing was written."
msgstr "No s’ha pogut desar l’historial de canvis; no s’ha escrit res."

#: src/Content/InsertRequest.php:115
msgid "The anchor is not part of the sentence."
msgstr "L’àncora no forma part de la frase."

#: src/Content/Linker.php:56
msgid "The anchor cannot be empty or start or end with a space."
msgstr "L’àncora no pot estar buida ni començar o acabar amb un espai."

#: src/Content/Linker.php:96
msgid "That text is already linked."
msgstr "Aquest text ja està enllaçat."

#: src/Content/Linker.php:99
msgid "This text is a heading and links in headings are not allowed."
msgstr "Aquest text és un encapçalament i no es permeten enllaços als encapçalaments."

#: src/Content/Linker.php:103
msgid "This text is the citation of a quote and is not linked."
msgstr "Aquest text és la font d’una cita i no s’enllaça."

#: src/Content/Linker.php:106
msgid "This text is in a quote and links in quotes are not allowed."
msgstr "Aquest text es troba en una cita i no es permeten enllaços a les cites."

#: src/Content/Linker.php:109
msgid "This text is in a table and links in tables are not allowed."
msgstr "Aquest text es troba en una taula i no es permeten enllaços a les taules."

#: src/Content/Linker.php:112
msgid "The anchor includes a shortcode, code or a line break and cannot be linked safely."
msgstr "L’àncora inclou un codi de substitució, codi o un salt de línia i no es pot enllaçar de manera segura."

#: src/Content/Linker.php:133
msgid "The anchor crosses text formatting (bold, italics…) and cannot be linked without breaking it."
msgstr "L’àncora travessa el format del text (negreta, cursiva…) i no es pot enllaçar sense trencar-lo."

#: src/Content/Linker.php:155 src/Content/LinkFixer.php:52
msgid "The link address is not valid."
msgstr "L’adreça de l’enllaç no és vàlida."

#: src/Content/LinkFixer.php:93
msgid "The post contains markup (nested links, scripts, styles…) that cannot be scanned safely, so it was left untouched."
msgstr "L’entrada conté marcatge (enllaços imbricats, scripts, estils…) que no es pot analitzar de manera segura, de manera que s’ha deixat intacta."

#: src/Content/LinkFixer.php:110
msgid "The post no longer matches the list (the link was moved, edited or is not stored in its content). Nothing was changed; reload the list."
msgstr "L’entrada ja no coincideix amb la llista (l’enllaç s’ha mogut, s’ha editat o no es desa al contingut). No s’ha canviat res; torna a carregar la llista."

#: src/Content/LinkFixer.php:128
msgid "The link address could not be changed safely, so the post was left untouched."
msgstr "L’adreça de l’enllaç no s’ha pogut canviar de manera segura, de manera que s’ha deixat intacta l’entrada."

#: src/Content/LinkFixer.php:173
msgid "Removing the link would break this block (a button, an image…). Change its destination instead, or edit the entry."
msgstr "Eliminar l’enllaç trencaria aquest bloc (un botó, una imatge…). Canvia’n la destinació o edita l’entrada."

#: src/Content/LinkFixer.php:182
msgid "The address of this link is also stored in the settings of its block, so it is not changed here. Edit the entry instead."
msgstr "L’adreça d’aquest enllaç també es desa als paràmetres del bloc, de manera que no es canvia aquí. Edita l’entrada."

#: src/Content/PostWriter.php:115
msgid "The post does not exist or is in the trash."
msgstr "L’entrada no existeix o és a la paperera."

#: src/Content/PostWriter.php:120
msgid "You do not have permission to edit this post."
msgstr "No tens permís per editar aquesta entrada."

#: src/Content/PostWriter.php:163
msgid "Another change is being applied to this post; try again in a moment."
msgstr "S’està aplicant un altre canvi a aquesta entrada; torna-ho a provar d’aquí a un moment."

#: src/Content/PostWriter.php:247 src/History/BatchJob.php:384
#: src/History/BatchJob.php:454 src/History/Redo.php:193
#: src/History/Undo.php:117
msgid "WordPress could not save the post; nothing was changed."
msgstr "WordPress no ha pogut desar l’entrada; no s’ha canviat res."

#: src/Content/PostWriter.php:328
msgid "This post is open in your editor (maybe in another tab); add the link from there or close it and try again."
msgstr "Aquesta entrada és oberta a l’editor (potser en una altra pestanya); afegeix-hi l’enllaç des d’allà o tanca-la i torna-ho a provar."

#: src/Content/PostWriter.php:332
msgid "someone else"
msgstr "algú altre"

#. translators: %s: name of the person who has the post open.
#: src/Content/PostWriter.php:338
#, php-format
msgid "This post has just been opened by %s; try again later."
msgstr "%s acaba d’obrir aquesta entrada; torna-ho a provar més tard."

#. translators: %s: name of the person who has the post open.
#: src/Content/PostWriter.php:340
#, php-format
msgid "This post is being edited by %s; try again later."
msgstr "%s està editant aquesta entrada; torna-ho a provar més tard."

#: src/Content/PostWriter.php:353
msgid "WordPress altered the content when saving it (security filters); the original was restored and the link was not inserted."
