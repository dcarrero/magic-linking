#: src/Rest/SuggestionPresenter.php:146
#, php-format
msgid "They share: %s"
msgstr "Comparten: %s"

#: src/Rest/SuggestionPresenter.php:149
msgid "The anchor matches the title of the destination"
msgstr "El ancla coincide con el título del destino"

#: src/Rest/SuggestionPresenter.php:152
msgid "The anchor matches the focus keyword of the destination"
msgstr "El ancla coincide con la palabra clave principal del destino"

#: src/Rest/SuggestionPresenter.php:155
msgid "The destination is an orphan (0 inbound links)"
msgstr "El destino es huérfano (0 enlaces entrantes)"

#: src/Rest/SuggestionPresenter.php:158
msgid "Very similar in meaning"
msgstr "Muy parecidas por significado"

#: src/Rest/SuggestionsController.php:242
msgid "The content is too long to analyze."
msgstr "El contenido es demasiado largo para analizarlo."

#: src/Rest/SuggestionsController.php:409
msgid "Each link needs the post, the destination, the sentence, the offset and the anchor."
msgstr "Cada enlace necesita la entrada, el destino, la frase, el desplazamiento y el ancla."

