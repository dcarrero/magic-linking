# Lo que NO entra en el ZIP de wordpress.org (bin/zip.sh).
# assets/src, package.json, tsconfig.json y webpack.config.js SÍ entran: son el código
# fuente legible del JavaScript compilado (norma 4 de wordpress.org).
# De src/Engine viaja lo que usa el plugin (indexado léxico y sugerencias, F1-04 y F1-07). Quedan fuera
# el índice en memoria (solo el banco y las pruebas), los vectores en memoria y el contrato de embeddings,
# que llegan con la IA (F1-14).
/src/Engine/Embedder.php
/src/Engine/MemoryIndex.php
/src/Engine/MemoryVectors.php
/.git
/.claude
/.gstack
/.vscode
/.idea
/.github
/.wp-env.json
/.wp-env.override.json
/.distignore
/.gitignore
/.editorconfig
/.DS_Store
/node_modules
/bin
/dist
/tests
/composer.lock
/package-lock.json
/phpcs.xml.dist
/phpstan.neon.dist
/phpunit.xml.dist
/HOOKS.md
/CLAUDE.md
/.phpunit.result.cache
.gitkeep
/README.md
/playwright.config.ts
/test-results
/playwright-report
/.wordpress-org
# Las traducciones viajan compiladas (.mo para PHP y .json para JavaScript); los .po son su fuente
# y WordPress no los lee. Quitarlos ahorra unos 80 KB del ZIP con seis idiomas.
/languages/*.po
