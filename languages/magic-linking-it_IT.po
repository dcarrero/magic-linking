#: src/Cli/Command.php:207
#, php-format
msgid "%d entry analyzed."
msgid_plural "%d entries analyzed."
msgstr[0] "%d contenuto analizzato."
msgstr[1] "%d contenuti analizzati."

#: src/Cli/Command.php:217
msgid "The process did not finish. Check its state with: wp magic-linking status"
msgstr "Il processo non è terminato. Controllane lo stato con: wp magic-linking status"

#: src/Cli/Command.php:350
msgid "Invalid filter. Use: all, orphans, low, over or broken."
msgstr "Filtro non valido. Usa: all, orphans, low, over o broken."

#: src/Cli/Command.php:353
msgid "Invalid column for --orderby."
msgstr "Colonna non valida per --orderby."

#: src/Cli/Command.php:476
msgid "Unknown action. Use: list, pause, resume or cancel."
msgstr "Azione sconosciuta. Usa: list, pause, resume o cancel."

