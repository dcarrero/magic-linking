#: src/Rest/JobsController.php:205 src/Rest/JobsController.php:220
msgid "That process cannot be changed in its current state."
msgstr "Aquest procés no es pot canviar en el seu estat actual."

#. translators: 1: process ID, 2: new state.
#: src/Cli/Command.php:513
#, php-format
msgid "Process %1$d is now %2$s."
msgstr "L’estat del procés %1$d ara és %2$s."

#. translators: %s: batch ID.
#: src/Cli/Command.php:610
#, php-format
msgid "There are more batches. Continue with: wp magic-linking history list --before=%s"
msgstr "Hi ha més lots. Continua amb: wp magic-linking history list --before=%s"

#: src/Cli/Command.php:635
msgid "Unknown action. Use: list, undo, redo, purge or export."
msgstr "Acció desconeguda. Utilitza: list, undo, redo, purge o export."

