msgstr "No se ha podido comprobar que el cambio sea solo quitar el enlace; no se ha escrito nada."

#: src/History/Undo.php:193
msgid "The change could not be confirmed as only restoring the link; nothing was written."
msgstr "No se ha podido confirmar que el cambio sea solo devolver el enlace; no se ha escrito nada."

#: src/History/Undo.php:350
msgid "Destination restored."
msgstr "Destino restaurado."

#: src/History/Undo.php:352
msgid "Link put back."
msgstr "Enlace devuelto a su sitio."

#: src/History/Undo.php:354
msgid "Link undone."
msgstr "Enlace deshecho."

#: src/History/Undo.php:366
msgid "This post was edited afterwards; restore the link address by hand."
msgstr "La entrada se editó después; restaura la dirección del enlace a mano."

#: src/History/Undo.php:368
msgid "This post was edited afterwards; put the link back by hand."
msgstr "La entrada se editó después; vuelve a poner el enlace a mano."

#: src/History/Undo.php:370
msgid "This post was edited afterwards; remove the link by hand."
msgstr "Esta entrada se editó después; quita el enlace a mano."

